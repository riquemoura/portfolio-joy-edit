{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "my-joyful-portfolio",
      "version": "0.1.0",
      "title": "My Joyful Portfolio"
    },
    "tools": [
      {
        "name": "list_catalogs",
        "title": "List catalogs",
        "description": "List all catalogs with their id, name and product count.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_products",
        "title": "List products",
        "description": "List products of a catalog in their manual display order.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "catalog_id": {
              "type": "string",
              "description": "Catalog id returned by list_catalogs."
            },
            "include_page_breaks": {
              "type": "boolean",
              "description": "Include page-break markers (default false)."
            }
          },
          "required": [
            "catalog_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_product",
        "title": "Create product",
        "description": "Add a product to a catalog. It is appended at the end of the catalog order.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "catalog_id": {
              "type": "string",
              "description": "Catalog id to add the product to."
            },
            "name": {
              "type": "string",
              "description": "Product name."
            },
            "price": {
              "type": "number",
              "description": "Product price."
            },
            "description": {
              "type": "string",
              "description": "Optional product description."
            },
            "image_url": {
              "type": "string",
              "description": "Optional public image URL."
            }
          },
          "required": [
            "catalog_id",
            "name",
            "price"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_product",
        "title": "Update product",
        "description": "Update name, price, description or image of an existing product.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Product id."
            },
            "name": {
              "type": "string"
            },
            "price": {
              "type": "number"
            },
            "description": {
              "type": "string"
            },
            "image_url": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "delete_product",
        "title": "Delete product",
        "description": "Permanently delete a product from its catalog.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Product id to delete."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
